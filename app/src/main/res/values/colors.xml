<?xml version="1.0" encoding="utf-8"?>
<!--
  길동무 색 (낮). 밤 색은 values-night/colors.xml. 차의 낮·밤 모드를 따라 자동으로 바뀐다 (Pleos 디자인 가이드).
  글자와 바탕의 대비는 모두 4.5:1 이상이다.
-->
<resources>
    <color name="gd_bg">#F4F3EE</color>
    <color name="gd_surface">#FFFFFF</color>
    <color name="gd_road">#DEDCD3</color>
    <color name="gd_lane">#FFFFFF</color>
    <color name="gd_text">#1C1C1A</color>
    <color name="gd_text_sub">#5F5E5A</color>
    <color name="gd_outline">#888780</color>
    <color name="gd_press">#33888780</color>

    <!-- 듣기: 새싹의 초록. 남기기: 씨앗의 호박색. 낮·밤 모두 밝은 바탕에 어두운 글자(대비 6.5:1 이상). -->
    <color name="gd_go">#97C459</color>
    <color name="gd_on_go">#173404</color>
    <color name="gd_seed">#EF9F27</color>
    <color name="gd_on_seed">#412402</color>
    <!-- 녹음 중: 끝내기 버튼 -->
    <color name="gd_rec">#A32D2D</color>
    <color name="gd_on_rec">#FFFFFF</color>

    <!-- 길 띠에서 지금 묻거나 듣는 한마디의 테두리 (바탕과 3:1 이상) -->
    <color name="gd_highlight">#3B6D11</color>

    <!-- 길 띠의 단계 테두리 -->
    <color name="gd_pin_bg">#FFFFFF</color>
    <color name="gd_stage_seed">#BA7517</color>
    <color name="gd_stage_sprout">#639922</color>
    <color name="gd_stage_flower">#D4537E</color>
    <color name="gd_stage_memory">#7F77DD</color>
</resources>
