<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 길동무 서버 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 한마디 녹음 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 표준 위치 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 창을 닫은 뒤 백그라운드 동작 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AAOS 표준 Car API -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- Pleos Vehicle State: 와이퍼(CAR_WINDOWS), 전조등(CAR_LIGHTS), 배터리(CAR_ENERGY) -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- Pleos NaviHelper: 현재 위치·경로·회전 정보 조회 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <application
        android:icon="@android:drawable/ic_menu_mylocation"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- 다이얼(로터리) 컨트롤러는 아직 지원하지 않음 -->
        <meta-data
            android:name="com.hmg.rotary.ROTARY_SUPPORTED"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 화면을 띄울 수 있다고 선언(DO) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
