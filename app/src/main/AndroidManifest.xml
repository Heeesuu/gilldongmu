<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 길동무 서버 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 한마디 녹음 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 표준 위치 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 창을 닫은 뒤 백그라운드 동작 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AAOS 표준 Car API -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- Pleos Vehicle State: 와이퍼(CAR_WINDOWS), 전조등(CAR_LIGHTS), 배터리(CAR_ENERGY) -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- Pleos NaviHelper: 현재 위치·경로·회전 정보 조회 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- 안드로이드 11부터는 선언해야 차에 들어 있는 음성 인식·TTS 서비스가 보인다 (말로 대답하기, "들을까요?" 읽기). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".GildongmuApp"
        android:icon="@android:drawable/ic_menu_mylocation"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Gildongmu">

        <!-- 다이얼(로터리) 컨트롤러는 아직 지원하지 않음 -->
        <meta-data
            android:name="com.hmg.rotary.ROTARY_SUPPORTED"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- 화면 나누기·낮밤 전환 때 Activity를 다시 만들지 않고 화면만 다시 그린다. 다시 만들면 듣던 한마디가 끊긴다. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 화면을 띄울 수 있다고 선언(DO) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!--
          화면 밖 안내: 내비를 전체 화면으로 띄워도 위치를 받고 한마디를 튼다. 알림의 "끄기"로 멈춘다.
          종류는 권한에 맞춰 코드에서 고른다(GuideService).
        -->
        <service
            android:name=".GuideService"
            android:exported="false"
            android:foregroundServiceType="location|mediaPlayback|microphone" />

        <!--
          Gleo AI 음성 명령(Gleo Interface). assets/schema.json의 함수 이름을 액션으로 받는다.
          스키마의 component가 "service"라서 Gleo는 브로드캐스트로 보낸다. Gleo가 다른 앱이라 exported여야 한다.
        -->
        <receiver
            android:name=".gleo.GleoActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="CONTROL_ROAD_MESSAGES" />
                <action android:name="THANK_ROAD_MESSAGE" />
                <action android:name="RECORD_ROAD_MESSAGE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
